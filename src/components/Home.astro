---
// The whole landing page, parameterised by locale. A new language is a one-line page that
// renders this with a different `lang` — see src/i18n/index.ts.
import Base from '../layouts/Base.astro'
import WorkspaceHome from './WorkspaceHome.astro'
import Faq from './Faq.astro'
import Cta from './Cta.astro'
import { type Lang } from '../i18n'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
---

<Base lang={lang} path="/">
  <WorkspaceHome lang={lang} />
  <Faq lang={lang} />
  <Cta lang={lang} />
</Base>
